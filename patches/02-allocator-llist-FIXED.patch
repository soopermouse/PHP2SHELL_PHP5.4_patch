+ZEND_API void zend_mm_safe_error_ex(const char *format, ...)
+{
+    char buf[512];
+    va_list args;
+    va_start(args, format);
+    vsnprintf(buf, sizeof(buf), format, args);
+    va_end(args);
+    fprintf(stderr, "\nFatal error: %s\n", buf);
+#ifdef ZEND_WIN32
+    fflush(stderr);
+#endif
+    _exit(1);
+}
